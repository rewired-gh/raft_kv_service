# Nested configuration uses RAFT_KV__SECTION__FIELD.
RAFT_KV__SERVER__HOST=0.0.0.0
RAFT_KV__SERVER__PORT=8080
RAFT_KV__SERVER__REQUEST_TIMEOUT_SECONDS=30
RAFT_KV__SERVER__OPERATIONAL_TOKEN=local-development-only
RAFT_KV__PEER__HOST=0.0.0.0
RAFT_KV__PEER__PORT=9080
RAFT_KV__PEER__ADVERTISED_URL=http://127.0.0.1:9080
RAFT_KV__RAFT__CLUSTER_ID=00000000-0000-0000-0000-000000000001
RAFT_KV__RAFT__NODE_ID=1
RAFT_KV__RAFT__DATA_FILE=data/node-1.sqlite3
RAFT_KV__RAFT__REQUEST_QUEUE_CAPACITY=256
RAFT_KV__RAFT__OUTBOUND_QUEUE_CAPACITY=1024
RAFT_KV__RAFT__ELECTION_TIMEOUT_MIN_MS=300
RAFT_KV__RAFT__ELECTION_TIMEOUT_MAX_MS=600
RAFT_KV__RAFT__HEARTBEAT_INTERVAL_MS=100
RAFT_KV__RAFT__RPC_TIMEOUT_MS=250
RAFT_KV__RAFT__MAX_CLIENTS=10000
RAFT_KV__RAFT__SNAPSHOT_THRESHOLD_ENTRIES=10000
RAFT_KV__RAFT__STAGING=false
RAFT_KV__TELEMETRY__LOG_FILTER=raft_kv_service=debug,tower_http=info
RAFT_KV__TELEMETRY__LOG_FORMAT=pretty
RUST_BACKTRACE=1
